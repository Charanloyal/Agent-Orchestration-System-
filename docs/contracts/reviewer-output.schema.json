{
  "$defs": {
    "ReviewFinding": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "unsupported_claim",
            "contradiction",
            "missing_section",
            "citation_error",
            "other"
          ],
          "title": "Category",
          "type": "string"
        },
        "claim_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Claim Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Evidence Ids",
          "type": "array"
        },
        "finding_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Finding Id",
          "type": "string"
        },
        "requested_action": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Requested Action",
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocker",
            "major",
            "minor"
          ],
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "severity",
        "category",
        "requested_action"
      ],
      "title": "ReviewFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "findings": {
      "items": {
        "$ref": "#/$defs/ReviewFinding"
      },
      "maxItems": 50,
      "title": "Findings",
      "type": "array"
    },
    "outcome": {
      "enum": [
        "pass",
        "revise",
        "insufficient_evidence"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "report_version": {
      "minimum": 1,
      "title": "Report Version",
      "type": "integer"
    },
    "review_round": {
      "maximum": 2,
      "minimum": 1,
      "title": "Review Round",
      "type": "integer"
    }
  },
  "required": [
    "report_version",
    "review_round",
    "outcome"
  ],
  "title": "ReviewerOutput",
  "type": "object"
}
