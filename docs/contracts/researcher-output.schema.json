{
  "$defs": {
    "ResearchFinding": {
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "statement": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "statement",
        "evidence_ids"
      ],
      "title": "ResearchFinding",
      "type": "object"
    },
    "SourceConflict": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 2,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "description",
        "evidence_ids"
      ],
      "title": "SourceConflict",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "conflicts": {
      "items": {
        "$ref": "#/$defs/SourceConflict"
      },
      "maxItems": 20,
      "title": "Conflicts",
      "type": "array"
    },
    "evidence_ids": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
        "type": "string"
      },
      "maxItems": 100,
      "title": "Evidence Ids",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/ResearchFinding"
      },
      "maxItems": 50,
      "title": "Findings",
      "type": "array"
    },
    "task_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Task Id",
      "type": "string"
    },
    "unresolved_questions": {
      "items": {
        "maxLength": 500,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 20,
      "title": "Unresolved Questions",
      "type": "array"
    }
  },
  "required": [
    "task_id"
  ],
  "title": "ResearcherOutput",
  "type": "object"
}
