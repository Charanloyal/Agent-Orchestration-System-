{
  "additionalProperties": false,
  "properties": {
    "collected_at": {
      "format": "date-time",
      "title": "Collected At",
      "type": "string"
    },
    "evidence_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Evidence Id",
      "type": "string"
    },
    "locator": {
      "anyOf": [
        {
          "maxLength": 200,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Locator"
    },
    "source_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Source Id",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "title": "Task Id",
      "type": "string"
    },
    "text": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "text_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Text Sha256",
      "type": "string"
    }
  },
  "required": [
    "evidence_id",
    "source_id",
    "task_id",
    "text",
    "text_sha256",
    "collected_at"
  ],
  "title": "EvidencePassage",
  "type": "object"
}
