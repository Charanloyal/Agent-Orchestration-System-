{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "enum": [
            "fact",
            "inference",
            "recommendation",
            "conflict",
            "unknown"
          ],
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "kind",
        "text"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ReportSection": {
      "additionalProperties": false,
      "properties": {
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Claims",
          "type": "array"
        },
        "section_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
          "title": "Section Id",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "section_id",
        "title",
        "claims"
      ],
      "title": "ReportSection",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "plan_version": {
      "minimum": 1,
      "title": "Plan Version",
      "type": "integer"
    },
    "report_version": {
      "minimum": 1,
      "title": "Report Version",
      "type": "integer"
    },
    "sections": {
      "items": {
        "$ref": "#/$defs/ReportSection"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Sections",
      "type": "array"
    }
  },
  "required": [
    "report_version",
    "plan_version",
    "sections"
  ],
  "title": "WriterOutput",
  "type": "object"
}
